# ---------------------------------------------------------------------------
# Kijamii Timesheets — environment variables
#
# Copy to `.env` for local development and set the same values in your Vercel
# project settings for deployment. `.env` is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL and publishable key. Both of these are PUBLIC: they are compiled
# into the browser bundle by design, and every table they can reach is guarded
# by row-level security. Find them under Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase service role (required, SERVER ONLY) -------------------------
# Full database access, bypassing row-level security. This must NEVER be
# prefixed with VITE_ (that would ship it to the browser) and must never be
# committed. Used only for administrative maintenance scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access control (required) ---------------------------------------------
# Comma-separated email domains allowed to sign in. Anyone outside these
# domains authenticates but receives no timesheet access.
ALLOWED_EMAIL_DOMAINS=kijamii.com

# Comma-separated addresses granted the admin role on their first sign-in.
# At least one is required, or nobody can reach the admin overview.
SEED_ADMIN_EMAILS=

# --- Google Sheets export (optional) ---------------------------------------
# Leave blank to disable the export. When set, submitted weeks are written to
# this spreadsheet. Share the sheet with the service-account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private key from the service-account JSON, newlines written as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Deployment ------------------------------------------------------------
# Public origin of the deployed app, used to build the OAuth redirect URL.
VITE_SITE_URL=http://localhost:8080
